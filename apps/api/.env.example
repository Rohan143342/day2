# Local development configuration. Never commit real credentials or real
# provider keys; production values come from the secrets manager / KMS.

NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lending?schema=public

# openssl rand -hex 32
JWT_SECRET=replace-with-at-least-32-characters-of-random-value
JWT_ISSUER=lending-platform
ACCESS_TOKEN_TTL_SECONDS=600
REFRESH_TOKEN_TTL_DAYS=30

# openssl rand -base64 32  (each must decode to exactly 32 bytes)
FIELD_ENCRYPTION_KEY=
BLIND_INDEX_KEY=
OTP_PEPPER=

# "mock" is rejected at startup when NODE_ENV=production.
SMS_PROVIDER=mock

SWAGGER_ENABLED=true
